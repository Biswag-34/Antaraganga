# Optional overrides. Normal Vercel deployments need no SEO variables.
# Owner-approved production defaults are in content/seo-release.mjs.
# SITE_URL=https://www.antharagangaruralhospital.com
# Vercel uses VERCEL_ENV automatically. Other production hosts must set this at build AND runtime:
# DEPLOYMENT_ENVIRONMENT=production
# Emergency indexing disable; rebuild/redeploy after changing it:
# SEO_INDEXING_ENABLED=false
# Exact reviewed paths only. An explicitly empty value excludes all pages.
# SEO_APPROVED_PATHS=/,/hospital,/care
# Owned alternate hosts only. Paths and queries are preserved. Defaults normalize non-www .com.
# SEO_REDIRECT_HOSTS=antharagangaruralhospital.com
# Original proposal documents stay downloadable, with noindex headers by default.
# SEO_INDEX_DOCUMENTS=false
